{
  "model_name": "example-classifier",
  "data_source": "examples/training.csv",
  "label_column": "label",
  "state_root": "mlops/.state",
  "training": {
    "seed": 42,
    "epochs": 400,
    "learning_rate": 0.1,
    "test_fraction": 0.25
  },
  "registry": {
    "minimum_accuracy": 0.75
  },
  "deployment": {
    "image": "ghcr.io/orcacloud/ml-inference:0.1.0",
    "namespace": "mlops",
    "state_claim": "mlops-state",
    "replicas": 2
  },
  "monitoring": {
    "minimum_accuracy": 0.75,
    "maximum_p95_latency_ms": 500,
    "maximum_feature_drift_zscore": 3.0,
    "maximum_failures": 3
  }
}
